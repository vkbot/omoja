<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/hicar_bg_dialog"
        android:layout_width="784dp"
        android:layout_height="365dp">
        <ProgressBar
            android:id="@+id/progress_bar"
            android:background="@android:color/transparent"
            android:layout_width="69dp"
            android:layout_height="69dp"
            android:indeterminateDrawable="@drawable/file_receive_progress"
            android:indeterminateDuration="2"
            android:indeterminateBehavior="repeat"
            app:layout_constraintBottom_toTopOf="@+id/progress_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="25sp"
            android:textColor="@color/second_text"
            android:gravity="center_horizontal"
            android:id="@+id/progress_text"
            android:layout_width="581dp"
            android:layout_height="wrap_content"
            android:text="@string/carplay_switch_device"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progress_bar"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="27sp"
            android:textColor="@color/second_text"
            android:gravity="center_horizontal"
            android:id="@+id/content"
            android:padding="10dp"
            android:layout_width="581dp"
            android:layout_height="wrap_content"
            android:text="@string/carplay_switch_device"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/hide"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/progress_text"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="24sp"
            android:textColor="@color/text_btn_ensure"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/hide"
            android:background="@drawable/bg_ensure"
            android:layout_width="267dp"
            android:layout_height="67dp"
            android:layout_marginBottom="53dp"
            android:text="@string/btn_hide"
            android:contentDescription="@string/btn_hide"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cancel"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="24sp"
            android:textColor="@color/text_btn_cancel"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/bg_cancel"
            android:layout_width="267dp"
            android:layout_height="67dp"
            android:text="@string/cancel"
            android:contentDescription="@string/cancel"
            android:textAllCaps="false"
            android:layout_marginStart="49dp"
            app:layout_constraintBottom_toBottomOf="@+id/hide"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/hide"
            app:layout_constraintTop_toTopOf="@+id/hide"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
