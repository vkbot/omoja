<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp">
        <Button
            android:id="@+id/btn_connect_service"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:minWidth="100dp"
            android:text="模拟Wallpaper连接服务"
            android:textFontWeight="300"/>
        <Button
            android:id="@+id/btn_disconnect_service"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="模拟Wallpaper断开服务"
            android:textFontWeight="400"/>
        <Button
            android:id="@+id/btn_register_callback"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="模拟Wallpaper注册回调"
            android:textFontWeight="500"/>
        <Button
            android:id="@+id/btn_unregister_callback"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="模拟Wallpaper反注册回调"
            android:textFontWeight="700"/>
        <Button
            android:id="@+id/btn_listen_wallpaper_change"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="监听壁纸改变"
            android:textFontWeight="900"/>
        <Button
            android:id="@+id/btn_get_custom_wallpapers"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="获取所有用户壁纸数据"
            android:textFontWeight="900"/>
        <Button
            android:id="@+id/btn_get_default_wallpapers"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="获取所有默认壁纸数据"
            android:textFontWeight="900"/>
        <Button
            android:id="@+id/btn_replace_default_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="替换默认壁纸图片"
            android:textFontWeight="900"/>
        <Button
            android:id="@+id/btn_replace_user_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="替换用户壁纸图片"
            android:textFontWeight="900"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp">
        <Button
            android:id="@+id/btn_fake_set1_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:minWidth="100dp"
            android:text="模拟设置1张图片"/>
        <Button
            android:id="@+id/btn_fake_set1_group_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="模拟设置1组白天黑色图片"/>
        <Button
            android:id="@+id/btn_fake_set5_group_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="模拟设置5组白天黑色图片"/>
        <Button
            android:id="@+id/btn_fake_delete_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="模拟设置删除图片"/>
        <Button
            android:id="@+id/btn_fake_delete_group_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="模拟删除5张图片"/>
        <Button
            android:id="@+id/btn_get_wallpapers"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="获取FileProvier提供的图片"/>
        <Button
            android:id="@+id/btn_reset_system_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="模拟重置系统图片"/>
        <Button
            android:id="@+id/btn_get_current_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="获取当前壁纸"/>
        <Button
            android:id="@+id/btn_change_current_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="切换当前壁纸"/>
        <Button
            android:id="@+id/btn_hide_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="隐藏某个壁纸"/>
        <Button
            android:id="@+id/btn_show_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="显示某个壁纸"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp">
        <Button
            android:id="@+id/btn_enable_live_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:minWidth="100dp"
            android:text="切换至动态壁纸"/>
        <Button
            android:id="@+id/btn_disable_live_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:minWidth="100dp"
            android:text="切换至静态壁纸"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</LinearLayout>
