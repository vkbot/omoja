<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.views.ShakeRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="@dimen/widget_item_2x1_width"
    android:layout_height="@dimen/widget_item_2x1_height">
    <com.android.launcher3.widget.Table2x1WidgetCell
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/widget_cell"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="@dimen/widget_icon_width_2x1"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="11dp">
        <com.android.launcher3.widget.WidgetImageView
            android:id="@+id/widget_preview"
            android:visibility="gone"
            android:layout_width="@dimen/widget_icon_width_2x1"
            android:layout_height="@dimen/widget_icon_height_2x1"/>
        <com.android.launcher3.views.LiveWidgetContainer
            android:id="@+id/live_widget_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/widget_item_text_size"
            android:textColor="@color/widget_item_edit_text_color"
            android:ellipsize="end"
            android:id="@+id/widget_name"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_below="@+id/iv_widget_preview"
            android:layout_centerHorizontal="true"/>
    </com.android.launcher3.widget.Table2x1WidgetCell>
    <ImageView
        android:id="@+id/iv_widget_add_badge"
        android:layout_width="@dimen/widget_item_badge_size"
        android:layout_height="@dimen/widget_item_badge_size"
        android:src="@drawable/ic_widget_add"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
</com.android.launcher3.views.ShakeRelativeLayout>
