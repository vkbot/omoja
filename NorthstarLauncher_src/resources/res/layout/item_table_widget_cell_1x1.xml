<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.views.ShakeRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/widget_item_1x1_width"
    android:layout_height="@dimen/widget_item_1x1_height">
    <com.android.launcher3.widget.TableWidgetCell
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/widget_cell"
        android:background="@drawable/bg_widget_table_bubbletext"
        android:focusable="true"
        android:layout_width="@dimen/widget_icon_width_1x1"
        android:layout_height="@dimen/widget_icon_height_1x1"
        android:layout_marginTop="11dp"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="10.6dp">
        <com.android.launcher3.widget.WidgetImageView
            android:id="@+id/widget_preview"
            android:layout_width="@dimen/widget_icon_width"
            android:layout_height="@dimen/widget_icon_height"
            android:layout_marginTop="19dp"/>
        <TextView
            android:textSize="@dimen/widget_item_text_size"
            android:textColor="@color/widget_item_edit_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/widget_name"
            android:layout_width="116.2dp"
            android:layout_height="match_parent"
            android:maxLines="2"
            android:layout_below="@+id/iv_widget_preview"
            android:layout_centerHorizontal="true"
            android:fallbackLineSpacing="false"/>
    </com.android.launcher3.widget.TableWidgetCell>
    <ImageView
        android:id="@+id/iv_widget_add_badge"
        android:layout_width="@dimen/widget_item_badge_size"
        android:layout_height="@dimen/widget_item_badge_size"
        android:src="@drawable/ic_widget_add"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
</com.android.launcher3.views.ShakeRelativeLayout>
