<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/item_root_view"
    android:layout_width="@dimen/hicar_icon_height_weight"
    android:layout_height="200dp">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/item_icon"
        android:layout_width="@dimen/hicar_icon_image_height_weight"
        android:layout_height="@dimen/hicar_icon_image_height_height"
        android:layout_marginTop="@dimen/hicar_icon_image_margin_top"/>
    <TextView
        android:textSize="@dimen/hicar_icon_image_text_size"
        android:textColor="@color/hicar_txt_app_list_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hicar_icon_image_text_margin_top"
        android:includeFontPadding="false"/>
</LinearLayout>
