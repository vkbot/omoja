<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/rootbg"
        android:background="@drawable/dialog_background_drawable"
        android:layout_width="@dimen/dimen_720dp"
        android:layout_height="347dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="27sp"
            android:textColor="@color/second_text"
            android:gravity="center_horizontal"
            android:id="@+id/content"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="93dp"
            android:text="@string/hicar_file_receive"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="28sp"
            android:textColor="@color/text_btn_ensure"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/confirm"
            android:background="@drawable/shape_fl_common_dialog_btn_blue"
            android:layout_width="267dp"
            android:layout_height="72dp"
            android:layout_marginBottom="53dp"
            android:text="@string/btn_receive"
            android:contentDescription="@string/btn_receive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cancel"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="28sp"
            android:textColor="@color/text_btn_cancel"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/shape_fl_common_dialog_btn_grey"
            android:layout_width="267dp"
            android:layout_height="72dp"
            android:text="@string/cancel"
            android:contentDescription="@string/cancel"
            android:layout_marginStart="53dp"
            app:layout_constraintBottom_toBottomOf="@+id/confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/confirm"
            app:layout_constraintTop_toTopOf="@+id/confirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
