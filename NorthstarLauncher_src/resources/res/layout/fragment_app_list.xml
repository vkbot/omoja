<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.views.AllAppsRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/allAppsRootView"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@+id/tab_container">
    <View
        android:id="@+id/view_left"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_centerVertical="true"
        android:soundEffectsEnabled="false"
        android:contentDescription="@string/voice_slide_left"
        android:layout_alignParentStart="true"/>
    <View
        android:id="@+id/view_right"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_centerVertical="true"
        android:soundEffectsEnabled="false"
        android:contentDescription="@string/voice_slide_right"
        android:layout_alignParentEnd="true"/>
    <com.android.launcher3.views.dragableviews.OverScrollHLayout
        android:id="@+id/app_list_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.android.launcher3.activity.AppListRecyclerView
            android:id="@+id/app_list"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="630dp"
            android:overScrollMode="never"/>
    </com.android.launcher3.views.dragableviews.OverScrollHLayout>
    <com.android.launcher3.activity.view.AppListIndicator
        android:layout_gravity="center_horizontal"
        android:id="@+id/app_indicator"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_below="@+id/app_list_container"/>
</com.android.launcher3.views.AllAppsRootView>
