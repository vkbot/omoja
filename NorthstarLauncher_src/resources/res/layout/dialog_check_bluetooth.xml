<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/hicar_bg_dialog"
        android:layout_width="752dp"
        android:layout_height="285dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="27sp"
            android:textColor="@color/second_text"
            android:gravity="center_horizontal"
            android:id="@+id/content"
            android:padding="10dp"
            android:layout_width="581dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="53dp"
            android:text="@string/bluetooth_switch_device_dialog"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="24sp"
            android:textColor="@color/text_btn_ensure"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/confirm"
            android:background="@drawable/bg_ensure"
            android:layout_width="267dp"
            android:layout_height="67dp"
            android:layout_marginBottom="53dp"
            android:text="@string/btn_confirm"
            android:contentDescription="@string/btn_confirm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cancel"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="24sp"
            android:textColor="@color/text_btn_cancel"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/bg_cancel"
            android:layout_width="267dp"
            android:layout_height="67dp"
            android:text="@string/cancel"
            android:contentDescription="@string/cancel"
            android:layout_marginStart="49dp"
            app:layout_constraintBottom_toBottomOf="@+id/confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/confirm"
            app:layout_constraintTop_toTopOf="@+id/confirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
