<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.LauncherRootView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.launcher3.dragndrop.DragLayer
        android:id="@+id/drag_layer"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">
        <com.android.launcher3.views.LiveWallpaperView
            android:id="@+id/live_wallpaper_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            launcher:layout_ignoreInsets="true"/>
        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
        <com.android.launcher3.views.ImageDragView
            android:id="@+id/view_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            launcher:layout_ignoreInsets="true"/>
        <com.android.launcher3.views.LandmarkWallpaperView
            android:id="@+id/landmark_wallpaper_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            launcher:layout_ignoreInsets="true"/>
        <FrameLayout
            android:id="@+id/folder_bg"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="#33000000"
            android:importantForAccessibility="no"
            launcher:layout_ignoreInsets="true">
            <com.android.launcher3.views.blur.BlurView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                launcher:displayStrategy="always"/>
        </FrameLayout>
        <com.android.launcher3.Workspace
            android:theme="@style/HomeScreenElementTheme"
            android:layout_gravity="bottom"
            android:id="@+id/workspace"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_launcher_workspace"
            android:layout_marginBottom="@dimen/margin_launcher_workspace"/>
        <com.android.launcher3.views.blur.BlurView
            android:layout_gravity="bottom"
            android:id="@+id/navi_blur_view"
            android:layout_width="match_parent"
            android:layout_height="85.3dp"
            android:importantForAccessibility="no"
            launcher:displayStrategy="always"
            launcher:layout_ignoreInsets="true"/>
        <include
            android:id="@+id/hotseat"
            layout="@layout/hotseat"/>
        <include
            android:id="@+id/overview_panel"
            layout="@layout/overview_panel"/>
    </com.android.launcher3.dragndrop.DragLayer>
    <com.android.launcher3.views.FestivalImageView
        android:layout_gravity="end"
        android:id="@+id/festival_view"
        android:visibility="gone"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="120dp"
        android:contentDescription="@null"
        android:layout_marginEnd="128dp"/>
</com.android.launcher3.LauncherRootView>
