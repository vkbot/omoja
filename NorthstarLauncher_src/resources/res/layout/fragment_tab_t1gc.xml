<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:id="@+id/ll_selector"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="33sp"
        android:textColor="@color/widget_table_title_selected"
        android:gravity="center"
        android:id="@+id/tv_tab_apps"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:text="@string/applist_tab_apps"
        android:fontFamily="sans-serif-medium"/>
    <com.android.launcher3.activity.view.MixLauncherSpinner
        android:gravity="center"
        android:id="@+id/tv_tab_mix_launcher"
        android:background="@drawable/spinner_background"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:popupBackground="@drawable/mix_launcher_drop_down_background"
        android:layout_toEndOf="@+id/tv_tab_apps"/>
</RelativeLayout>
