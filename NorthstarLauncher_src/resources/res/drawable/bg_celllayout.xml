<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_active="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/widget_workspace_bg_corner"/>
                    <solid android:color="@color/spring_loaded_panel_color"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_drag_can_accept="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/widget_workspace_bg_corner"/>
                    <solid android:color="@color/spring_loaded_panel_color"/>
                </shape>
            </item>
            <item>
                <bitmap
                    android:gravity="center"
                    android:src="@mipmap/ic_workspace_empty"/>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/widget_workspace_bg_corner"/>
                    <solid android:color="@color/spring_loaded_panel_color"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
