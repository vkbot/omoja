<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="600"
        motion:motionInterpolator="easeInOut">
        <OnClick
            motion:clickAction="toggle"
            motion:targetId="@+id/centerButton"/>
    </Transition>
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/centerButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/btn1"
            motion:layout_constraintStart_toStartOf="@+id/centerButton"
            motion:layout_constraintTop_toTopOf="@+id/centerButton"/>
        <Constraint
            android:id="@+id/btn2"
            motion:layout_constraintStart_toStartOf="@+id/centerButton"
            motion:layout_constraintTop_toTopOf="@+id/centerButton"/>
        <Constraint
            android:id="@+id/btn3"
            motion:layout_constraintStart_toStartOf="@+id/centerButton"
            motion:layout_constraintTop_toTopOf="@+id/centerButton"/>
        <Constraint
            android:id="@+id/btn4"
            motion:layout_constraintStart_toStartOf="@+id/centerButton"
            motion:layout_constraintTop_toTopOf="@+id/centerButton"/>
        <Constraint
            android:id="@+id/btn5"
            motion:layout_constraintStart_toStartOf="@+id/centerButton"
            motion:layout_constraintTop_toTopOf="@+id/centerButton"/>
        <Constraint
            android:id="@+id/btn6"
            motion:layout_constraintStart_toStartOf="@+id/centerButton"
            motion:layout_constraintTop_toTopOf="@+id/centerButton"/>
        <Constraint
            android:id="@+id/btn7"
            motion:layout_constraintStart_toStartOf="@+id/centerButton"
            motion:layout_constraintTop_toTopOf="@+id/centerButton"/>
        <Constraint
            android:id="@+id/btn8"
            motion:layout_constraintStart_toStartOf="@+id/centerButton"
            motion:layout_constraintTop_toTopOf="@+id/centerButton"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/centerButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/btn1"
            motion:layout_constraintCircle="@+id/centerButton"
            motion:layout_constraintCircleAngle="0"
            motion:layout_constraintCircleRadius="140dp"/>
        <Constraint
            android:id="@+id/btn2"
            motion:layout_constraintCircle="@+id/centerButton"
            motion:layout_constraintCircleAngle="45"
            motion:layout_constraintCircleRadius="140dp"/>
        <Constraint
            android:id="@+id/btn3"
            motion:layout_constraintCircle="@+id/centerButton"
            motion:layout_constraintCircleAngle="90"
            motion:layout_constraintCircleRadius="140dp"/>
        <Constraint
            android:id="@+id/btn4"
            motion:layout_constraintCircle="@+id/centerButton"
            motion:layout_constraintCircleAngle="135"
            motion:layout_constraintCircleRadius="140dp"/>
        <Constraint
            android:id="@+id/btn5"
            motion:layout_constraintCircle="@+id/centerButton"
            motion:layout_constraintCircleAngle="180"
            motion:layout_constraintCircleRadius="140dp"/>
        <Constraint
            android:id="@+id/btn6"
            motion:layout_constraintCircle="@+id/centerButton"
            motion:layout_constraintCircleAngle="225"
            motion:layout_constraintCircleRadius="140dp"/>
        <Constraint
            android:id="@+id/btn7"
            motion:layout_constraintCircle="@+id/centerButton"
            motion:layout_constraintCircleAngle="270"
            motion:layout_constraintCircleRadius="140dp"/>
        <Constraint
            android:id="@+id/btn8"
            motion:layout_constraintCircle="@+id/centerButton"
            motion:layout_constraintCircleAngle="315"
            motion:layout_constraintCircleRadius="140dp"/>
    </ConstraintSet>
</MotionScene>
