<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp">
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/lb"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/switch20"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/sw_LounchBOnOff"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
                <FrameLayout
                    android:background="@drawable/modern_field"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <Spinner
                        android:gravity="center_vertical"
                        android:id="@+id/spinner27"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:popupBackground="@color/modern_surface_high"
                        android:paddingStart="16dp"
                        android:paddingEnd="44dp"/>
                    <ImageView
                        android:layout_gravity="end"
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:src="@mipmap/drop"
                        android:contentDescription="@null"
                        android:layout_marginEnd="10dp"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/multi_button_core"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/sw_multi_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/sw_LounchBOnOffMulti"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
                <Button
                    android:id="@+id/button_setting_multubutton"
                    android:text="@string/b_settings"
                    android:layout_marginStart="12dp"
                    style="@style/ModernInlineButton"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
