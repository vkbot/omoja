<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/modern_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/modern_divider"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/storeAppIcon"
                android:background="@drawable/modern_action_row"
                android:padding="8dp"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/item_store"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp">
                <TextView
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/modern_text"
                    android:ellipsize="end"
                    android:id="@+id/storeAppName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/modern_text_secondary"
                    android:id="@+id/storeAppMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
            <ImageButton
                android:layout_gravity="top"
                android:id="@+id/storeDeleteAction"
                android:background="@drawable/modern_delete_button"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_modern_delete"
                android:contentDescription="@string/app_store_remove"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <Button
                android:id="@+id/storePrimaryAction"
                android:text="@string/download"
                android:layout_marginEnd="5dp"
                style="@style/ModernSplitButton"/>
            <Button
                android:id="@+id/storeOpenAction"
                android:text="@string/open"
                android:layout_marginStart="5dp"
                style="@style/ModernSplitButton"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
