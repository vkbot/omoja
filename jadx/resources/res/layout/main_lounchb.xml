<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            android:layout_marginTop="0dp"
            android:shadowColor="@color/headerTextShadowColor"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.flexbox.FlexboxLayout
                android:background="@color/FlexboxLayout_MainView"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp"
                app:alignContent="flex_start"
                app:alignItems="flex_start"
                app:flexWrap="wrap"
                app:justifyContent="center">
                <ImageView
                    android:layout_width="@dimen/layout_height_constant"
                    android:layout_height="@dimen/layout_height_constant"
                    android:src="@drawable/lb"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/switch20"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/layout_height_constant"
                    android:text="@string/sw_LounchBOnOff"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <FrameLayout
                    android:background="@drawable/border_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Spinner
                        android:textSize="20sp"
                        android:gravity="center"
                        android:id="@+id/spinner27"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:minHeight="@dimen/layout_height_constant"
                        android:popupBackground="@color/dropDownsBackground"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="40dp"
                        android:layout_height="@dimen/layout_height_constant"
                        android:src="@mipmap/drop"
                        android:layout_marginEnd="8dp"/>
                </FrameLayout>
            </com.google.android.flexbox.FlexboxLayout>
            <com.google.android.flexbox.FlexboxLayout
                android:background="@color/FlexboxLayout_MainView"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp"
                app:alignContent="flex_start"
                app:alignItems="flex_start"
                app:flexWrap="wrap"
                app:justifyContent="center">
                <ImageView
                    android:layout_width="@dimen/layout_height_constant"
                    android:layout_height="@dimen/layout_height_constant"
                    android:src="@drawable/multi_button_core"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/sw_multi_button"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/layout_height_constant"
                    android:text="@string/sw_LounchBOnOffMulti"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:id="@+id/button_setting_multubutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/b_settings"/>
            </com.google.android.flexbox.FlexboxLayout>
            <com.google.android.flexbox.FlexboxLayout
                android:background="@color/FlexboxLayout_MainView"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp"
                app:alignContent="flex_start"
                app:alignItems="flex_start"
                app:flexWrap="wrap"
                app:justifyContent="center">
                <ImageView
                    android:layout_width="@dimen/layout_height_constant"
                    android:layout_height="@dimen/layout_height_constant"
                    android:src="@drawable/goloshelp"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/sw_speech_button"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/layout_height_constant"
                    android:text="@string/sw_LounchBOnOffspeech"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:id="@+id/button_setting_speech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/b_settings"/>
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
