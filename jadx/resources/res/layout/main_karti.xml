<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/FlexboxLayout_MainView">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            android:layout_marginTop="0dp"
            android:shadowColor="@color/headerTextShadowColor"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.flexbox.FlexboxLayout
                android:background="@color/FlexboxLayout_MainView"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp"
                android:backgroundTint="@color/FlexboxLayout_MainView"
                app:alignContent="flex_start"
                app:alignItems="flex_start"
                app:flexWrap="wrap"
                app:justifyContent="center">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:background="@drawable/rounded_corners"
                        android:layout_width="@dimen/layout_height_constant"
                        android:layout_height="@dimen/layout_height_constant"
                        android:src="@drawable/set_navi"
                        android:scaleType="centerCrop"/>
                    <FrameLayout
                        android:background="@drawable/border_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant">
                        <Spinner
                            android:textSize="20sp"
                            android:gravity="center"
                            android:id="@+id/spinner8"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:popupBackground="@color/dropDownsBackground"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:layout_width="40dp"
                            android:layout_height="@dimen/layout_height_constant"
                            android:src="@mipmap/drop"
                            android:layout_marginEnd="8dp"/>
                    </FrameLayout>
                    <Button
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:id="@+id/button3"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/install"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:id="@+id/switch4"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/sw_camvisible"
                        android:layoutDirection="rtl"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:id="@+id/switch11"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/sw_limvisible"
                        android:layoutDirection="rtl"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:id="@+id/HUDNaviOnOff"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/sw_HUDNaviOnOff"
                        android:layoutDirection="rtl"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:id="@+id/switch_map_activity_fullscreen_gu"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/sw_map_activity_fullscreen_gu"
                        android:layoutDirection="rtl"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:id="@+id/switch_map_activity_max_performance"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/sw_map_activity_max_performance"
                        android:layoutDirection="rtl"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>
                <com.example.navistart.mainview.YMovLay
                    android:id="@+id/blok_lim_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:NameLayMov="@string/blok_lim_speed"
                    app:TwoOROne="2"
                    app:imgResurceMove="@drawable/speed_limit_40_sign_icon"/>
                <com.example.navistart.mainview.YMovLay
                    android:id="@+id/blok_man_help"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:NameLayMov="@string/blok_man_help"
                    app:TwoOROne="2"
                    app:imgResurceMove="@drawable/icon_maneuver_3410419"/>
                <com.example.navistart.mainview.YMovLay
                    android:id="@+id/blok_prog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:NameLayMov="@string/blok_prog"
                    app:TwoOROne="2"
                    app:imgResurceMove="@drawable/icon_route_549395"/>
                <com.example.navistart.mainview.YMovLay
                    android:id="@+id/blok_dpi_pp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:NameLayMov="@string/blok_dpi_pp"
                    app:TwoOROne="1"
                    app:imgResurceMove="@drawable/icon_dashboard_5382369"/>
                <com.example.navistart.mainview.YMovLay
                    android:id="@+id/blok_dpi_gu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:NameLayMov="@string/blok_dpi_gu"
                    app:TwoOROne="1"
                    app:imgResurceMove="@drawable/icon_tablet_6532339"/>
                <FrameLayout
                    android:background="@drawable/border_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/layout_height_constant">
                    <Spinner
                        android:textSize="20sp"
                        android:gravity="center"
                        android:id="@+id/spinner25"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:popupBackground="@color/dropDownsBackground"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="40dp"
                        android:layout_height="@dimen/layout_height_constant"
                        android:src="@mipmap/drop"
                        android:layout_marginEnd="8dp"/>
                </FrameLayout>
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
