<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imageZone"
        android:layout_width="@dimen/layout_height_constant"
        android:layout_height="@dimen/layout_height_constant"
        android:layout_margin="5dp"/>
    <Spinner
        android:id="@+id/zoneSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="200dp"
        android:minHeight="@dimen/layout_height_constant"
        android:layout_weight="1"
        android:spinnerMode="dialog"/>
    <CheckBox
        android:id="@+id/zoneCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/layout_height_constant"
        android:layout_margin="5dp"
        android:text="Вкл."/>
</LinearLayout>
