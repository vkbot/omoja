<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="vertical"
    android:layout_width="460dp"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <Button
                android:id="@+id/accelerationBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/b_back"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/acceleration_title"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:id="@+id/accelerationSpeed"
            android:background="?android:attr/colorBackground"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/acceleration_speed_zero"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/accelerationStatus"
            android:background="?android:attr/colorBackground"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/acceleration_status_ready"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/accelerationResults"
            android:background="?android:attr/colorBackground"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:textIsSelectable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <Button
            android:id="@+id/accelerationStartButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/acceleration_start"/>
        <Button
            android:id="@+id/accelerationResetButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/acceleration_reset"/>
    </LinearLayout>
</ScrollView>
