<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/MainLabel"
        android:text="@string/super_widgets_title"
        style="@style/ModernGroupTitle"/>
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/super_widgets_enabled"
        android:text="@string/super_widgets_enabled"
        style="@style/ModernMapSwitchRow"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/modern_text_secondary"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/super_widgets_description"/>
    <Button
        android:id="@+id/super_widgets_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/super_widgets_settings"
        style="@style/ModernWideButton"/>
</LinearLayout>
