<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="450dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/about_run_app_more_delay_help_text"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <SeekBar
            android:id="@+id/about_run_app_more_delay"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"/>
        <TextView
            android:gravity="center"
            android:id="@+id/textView_about_run_app_more_delay"
            android:layout_width="wrap_content"
            android:layout_height="60dp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/textView49"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_run_app_more_spi_help"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerVoiceCommands"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <Button
        android:id="@+id/btnAddCommand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dobavit"/>
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save"/>
</LinearLayout>
