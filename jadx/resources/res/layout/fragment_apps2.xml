<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/btnVertical"
                android:padding="6dp"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_split_vertical"/>
            <ImageView
                android:id="@+id/btnHorizontal"
                android:padding="6dp"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_split_horizontal"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:layout_gravity="center"
            android:id="@+id/splitRatioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/splitRatio30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 / 70"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/splitRatio50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50 / 50"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/splitRatio70"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="70 / 30"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
    <com.example.navistart.DialogUni.Fragmenti.MaxHeightRecyclerView
        android:id="@+id/recyclerView"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
