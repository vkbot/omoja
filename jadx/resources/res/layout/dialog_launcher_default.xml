<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#f6f8fc"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:padding="26dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_web_launcher"
                    android:contentDescription="@string/launcher_enable"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="18dp">
                    <TextView
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:textColor="#101828"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/launcher_default_options_title"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#667085"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/launcher_dialog_subtitle"/>
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#eaf3ff"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#8dbbff"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1456a0"
                        android:background="@drawable/bg_launcher_method_label"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/launcher_method_android_label"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>
                    <TextView
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#102a4c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/launcher_method_android_title"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="#36516f"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/launcher_method_android_description"
                        android:lineSpacingExtra="3dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:id="@+id/button_launcher_android_method"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/launcher_open_android_choice"
                        android:textAllCaps="false"
                        app:cornerRadius="17dp"
                        app:icon="@drawable/ic_web_launcher_symbol"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#98a2b3"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:text="@string/launcher_methods_separator"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#172033"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#69e4e8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/launcher_method_adb_label"/>
                    <TextView
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/launcher_method_adb_title"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="#c5cedc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/launcher_method_adb_description"
                        android:lineSpacingExtra="3dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#a7f3d0"
                        android:background="@drawable/bg_launcher_command"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/launcher_adb_commands"
                        android:lineSpacingExtra="5dp"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#98a8bd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/launcher_method_adb_after"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:textSize="17sp"
                android:textColor="#475467"
                android:id="@+id/button_launcher_dialog_close"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="@string/launcher_dialog_close"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
