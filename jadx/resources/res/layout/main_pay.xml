<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainPayViewLabel"
            android:background="@color/header"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            android:layout_marginTop="0dp"
            android:shadowColor="@color/headerTextShadowColor"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            app:autoSizeTextType="uniform"/>
        <FrameLayout
            android:background="@drawable/border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.flexbox.FlexboxLayout
                android:background="@color/FlexboxLayout_MainView"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp"
                app:alignContent="flex_start"
                app:alignItems="flex_start"
                app:flexWrap="wrap">
                <TextView
                    android:textSize="30sp"
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="@string/lorem_ipsum_one"
                    android:layoutDirection="rtl"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_margin="10dp">
                    <TextView
                        android:textSize="25dp"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:id="@+id/Pay_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boosty Pay:"/>
                    <ImageView
                        android:id="@+id/QRPAY"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/woha_donate"/>
                </LinearLayout>
            </com.google.android.flexbox.FlexboxLayout>
            <androidx.appcompat.widget.Toolbar
                android:layout_gravity="end|bottom"
                android:id="@+id/toolbar"
                android:background="@drawable/rounded_toolbar_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</merge>
