<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/modern_background"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.flexbox.FlexboxLayout
        android:background="@drawable/modern_panel"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flexWrap="nowrap">
        <Button
            android:id="@+id/button31"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/b_back"
            app:layout_flexGrow="1"
            style="@style/ModernFragmentButton"/>
        <Button
            android:id="@+id/btn_start_tests"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/b_start_test"
            app:layout_flexGrow="1"
            style="@style/ModernFragmentButton"/>
        <Button
            android:id="@+id/btn_stop_tests"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/b_stop_test"
            app:layout_flexGrow="1"
            style="@style/ModernFragmentButton"/>
        <Button
            android:id="@+id/btn_LogAll"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/diagnostic_log_all"
            app:layout_flexGrow="1"
            style="@style/ModernFragmentButton"/>
        <Button
            android:id="@+id/button30"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/diagnostic_log_more"
            app:layout_flexGrow="1"
            style="@style/ModernFragmentButton"/>
    </com.google.android.flexbox.FlexboxLayout>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <EditText
        android:textColor="@color/modern_text"
        android:textColorHint="@color/modern_text_secondary"
        android:id="@+id/filter_LogAll"
        android:background="@drawable/modern_field"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:hint="@string/diagnostic_log_filter"
        android:singleLine="true"
        android:inputType="text"/>
    <androidx.appcompat.widget.SwitchCompat
        android:textSize="15sp"
        android:textColor="@color/modern_text"
        android:id="@+id/sw_auto_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/sw_auto_scroll"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
    <ScrollView
        android:id="@+id/log_scroll_view"
        android:background="@drawable/modern_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/modern_text"
            android:id="@+id/log_text_view"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:fontFamily="monospace"/>
    </ScrollView>
</LinearLayout>
