<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/speech_bubble3"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/appIco"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    app:srcCompat="@drawable/icon_voice_message_6376305"/>
                <TextView
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:layout_gravity="center"
                    android:id="@+id/titleText"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="titleText"/>
            </LinearLayout>
            <TextView
                android:textSize="38sp"
                android:textColor="#000"
                android:id="@+id/messageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Очень длинный текст, который нужно переносить на новую строку, если он не помещается в ширину облака"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/LinearLayout_send_messadge"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="200dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/line_shape"/>
            <Button
                android:textSize="35sp"
                android:textColor="#007aff"
                android:id="@+id/otvetit_button"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="@string/otvetit"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/LinearLayout_send_messadge_edit"
                android:background="@drawable/speech_bubble4"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="200dp">
                <ImageButton
                    android:id="@+id/button_golos_messadge"
                    android:background="@android:color/transparent"
                    android:visibility="gone"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/microphone_off"
                    android:scaleType="fitXY"/>
                <ImageButton
                    android:id="@+id/button_send_messadge"
                    android:background="@android:color/transparent"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/send_ico2"
                    android:scaleType="fitXY"/>
                <EditText
                    android:textSize="30sp"
                    android:layout_gravity="center"
                    android:id="@+id/editText_send_messadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:ems="10"
                    android:inputType="textMultiLine"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
