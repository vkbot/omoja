<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/modern_safety_warning"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="82dp"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/bezo_ico1"
                    android:contentDescription="@null"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:textSize="15sp"
                    android:textColor="@color/modern_text"
                    android:gravity="start|center_vertical"
                    android:id="@+id/sw_bez"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/sw_Bez"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="14dp"/>
            </LinearLayout>
            <TextView
                android:layout_marginTop="18dp"
                android:text="@string/modern_safety_functions"
                style="@style/ModernGroupTitle"/>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/bez_aw_layFlex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:alignItems="stretch"
                app:flexDirection="column"
                app:flexWrap="nowrap"
                app:justifyContent="flex_start">
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_stolk"
                    android:text="@string/sw_stolk"
                    style="@style/ModernSafetySwitchRow"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ID_CAR_SPD_LIMIT_WARN_SET"
                    android:text="@string/ID_CAR_SPD_LIMIT_WARN_SET"
                    style="@style/ModernSafetySwitchRow"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ID_SPD_LIMIT_VALUE_CHANGE"
                    android:text="@string/ID_SPD_LIMIT_VALUE_CHANGE"
                    style="@style/ModernSafetySwitchRow"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ID_CAR_LDW"
                    android:text="@string/ID_CAR_LDW"
                    style="@style/ModernSafetySwitchRow"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ID_CAR_FCM_FRM_DAI_ON_OF"
                    android:text="@string/ID_CAR_FCM_FRM_DAI_ON_OF"
                    style="@style/ModernSafetySwitchRow"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ID_CAR_FCM_INHIBIT"
                    android:text="@string/ID_CAR_FCM_INHIBIT"
                    style="@style/ModernSafetySwitchRow"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ID_CAR_FCM_IES_ON_OFF"
                    android:text="@string/ID_CAR_FCM_IES_ON_OFF"
                    style="@style/ModernSafetySwitchRow"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ID_CAR_FCM_EMERGENCY_KEEY"
                    android:text="@string/ID_CAR_FCM_EMERGENCY_KEEY"
                    style="@style/ModernSafetySwitchRow"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ID_CAR_CIR_ENA_STS"
                    android:text="@string/ID_CAR_CIR_ENA_STS"
                    style="@style/ModernSafetySwitchRow"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ID_CAR_OPPOSITION_SWITCH"
                    android:text="@string/ID_CAR_OPPOSITION_SWITCH"
                    style="@style/ModernSafetySwitchRow"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/Driver_Monitoring_System"
                    android:text="@string/Driver_Monitoring_System"
                    style="@style/ModernSafetySwitchRow"/>
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
