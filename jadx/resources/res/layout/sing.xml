<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/modern_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <Button
                android:textSize="17sp"
                android:gravity="center"
                android:id="@+id/button29"
                android:layout_width="132dp"
                android:layout_height="50dp"
                android:layout_marginBottom="0dp"
                android:text="@string/b_back"
                style="@style/ModernStoreActionRow"/>
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/modern_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/modern_authorization_language"
                android:layout_weight="1"
                android:layout_marginStart="20dp"/>
        </LinearLayout>
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:alignContent="flex_start"
            app:alignItems="flex_start"
            app:flexWrap="wrap">
            <androidx.cardview.widget.CardView
                android:id="@+id/constraintLayout7"
                android:layout_width="480dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:minWidth="300dp"
                app:cardBackgroundColor="@color/modern_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_flexGrow="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/modern_window_header"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/modern_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ID"/>
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/modern_text"
                            android:ellipsize="middle"
                            android:id="@+id/textView20"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:textIsSelectable="true"
                            android:layout_marginStart="12dp"/>
                        <ImageView
                            android:id="@+id/imageView7"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/disconnected"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/textView21"
                        android:visibility="invisible"
                        android:layout_width="1dp"
                        android:layout_height="1dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/holo_red_light"
                        android:id="@+id/networkErrorText"
                        android:background="@drawable/modern_safety_warning"
                        android:padding="14dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/auth_network_error"/>
                    <TextView
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/modern_success"
                        android:id="@+id/textView24"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"/>
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/modern_text"
                        android:id="@+id/textView22"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/modern_text"
                        android:textColorHint="@color/modern_text_secondary"
                        android:id="@+id/editTextTextEmailAddress"
                        android:background="@drawable/modern_field"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:hint="Email"
                        android:inputType="textEmailAddress"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                    <Button
                        android:textSize="17sp"
                        android:gravity="center"
                        android:id="@+id/button9"
                        android:layout_marginTop="10dp"
                        android:text="@string/b_sing"
                        style="@style/ModernStoreActionRow"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/modern_text_secondary"
                        android:id="@+id/textView23"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/turn_pin"/>
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/modern_text"
                        android:id="@+id/editTextNumber"
                        android:background="@drawable/modern_field"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:inputType="number"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                    <Button
                        android:textSize="17sp"
                        android:gravity="center"
                        android:id="@+id/button10"
                        android:layout_marginTop="8dp"
                        android:text="@string/b_ok"
                        style="@style/ModernStoreActionRow"/>
                    <Button
                        android:textSize="17sp"
                        android:gravity="center"
                        android:id="@+id/button11"
                        android:layout_marginTop="12dp"
                        android:text="@string/b_exit"
                        style="@style/ModernStoreActionRow"/>
                    <Switch
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/modern_text"
                        android:id="@+id/switch17"
                        android:background="@drawable/modern_action_row"
                        android:padding="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="64dp"
                        android:text="@string/pdn_sw"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="380dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:minWidth="280dp"
                app:cardBackgroundColor="@color/modern_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_flexGrow="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="17sp"
                        android:text="@string/setLangApp"
                        style="@style/ModernGroupTitle"/>
                    <Button
                        android:textSize="17sp"
                        android:gravity="center"
                        android:id="@+id/button_lang"
                        style="@style/ModernStoreActionRow"/>
                    <TextView
                        android:textSize="17sp"
                        android:id="@+id/textView35"
                        android:layout_marginTop="10dp"
                        android:text="@string/puntowifi"
                        style="@style/ModernGroupTitle"/>
                    <Button
                        android:textSize="17sp"
                        android:gravity="center"
                        android:id="@+id/button19"
                        android:text="@string/wifimanager"
                        style="@style/ModernStoreActionRow"/>
                    <TextView
                        android:textSize="17sp"
                        android:id="@+id/app_perm_set"
                        android:layout_marginTop="10dp"
                        android:text="@string/str_app_perm_set"
                        style="@style/ModernGroupTitle"/>
                    <Button
                        android:textSize="17sp"
                        android:gravity="center"
                        android:id="@+id/b_start_act_app_perm"
                        android:text="@string/str_b_start_act_app_perm"
                        style="@style/ModernStoreActionRow"/>
                    <Button
                        android:textSize="17sp"
                        android:gravity="center"
                        android:id="@+id/b_start_act_app_sett"
                        android:text="@string/b_app_sett"
                        style="@style/ModernStoreActionRow"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="700dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:minWidth="300dp"
                app:cardBackgroundColor="@color/modern_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_flexGrow="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/modern_text_secondary"
                        android:id="@+id/textView25"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pdn_text"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>
</ScrollView>
