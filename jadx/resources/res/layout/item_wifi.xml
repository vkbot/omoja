<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/modern_action_row"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:minHeight="76dp"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/modern_text"
        android:ellipsize="end"
        android:id="@+id/ssidText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/modern_primary"
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/modern_text_secondary"
            android:id="@+id/signalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wifi_signal_unknown"/>
    </LinearLayout>
</LinearLayout>
