<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/main"
    android:background="@color/modern_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/modern_navigation_rail"
        android:background="@color/modern_navigation"
        android:paddingTop="18dp"
        android:paddingBottom="12dp"
        android:layout_width="250dp"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/modern_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/modern_brand_icon_card"
                android:layout_width="54dp"
                android:layout_height="54dp"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/modern_brand_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/jct_ico"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_name"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/modern_brand_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/modern_text"
                    android:id="@+id/modern_logo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/modern_text_secondary"
                    android:id="@+id/modern_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <ScrollView
            android:id="@+id/modern_navigation_scroll"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/modern_nav_home"
                    android:text="@string/modern_home"
                    android:drawableStart="@drawable/modern_nav_home"
                    style="@style/ModernNavItem"/>
                <TextView
                    android:id="@+id/modern_nav_startup"
                    android:text="@string/modern_startup"
                    android:drawableStart="@drawable/modern_nav_start"
                    style="@style/ModernNavItem"/>
                <TextView
                    android:id="@+id/modern_nav_comfort"
                    android:text="@string/modern_comfort"
                    android:drawableStart="@drawable/modern_nav_comfort"
                    style="@style/ModernNavItem"/>
                <TextView
                    android:id="@+id/modern_nav_tools"
                    android:visibility="gone"
                    android:text="@string/modern_tools"
                    android:drawableStart="@drawable/modern_nav_tools"
                    style="@style/ModernNavItem"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/modern_tool_navigation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/modern_tool_tab_store"
                        android:text="@string/item_store"
                        android:drawableStart="@drawable/modern_nav_widgets"
                        style="@style/ModernNavItem"/>
                    <TextView
                        android:id="@+id/modern_tool_tab_maps"
                        android:text="@string/karti"
                        android:drawableStart="@drawable/modern_nav_hud"
                        style="@style/ModernNavItem"/>
                    <TextView
                        android:id="@+id/modern_tool_tab_car"
                        android:text="@string/item_car_settings"
                        android:drawableStart="@drawable/modern_nav_comfort"
                        style="@style/ModernNavItem"/>
                    <TextView
                        android:id="@+id/modern_tool_tab_other"
                        android:text="@string/modern_useful_features"
                        android:drawableStart="@drawable/modern_nav_tools"
                        style="@style/ModernNavItem"/>
                    <TextView
                        android:id="@+id/modern_tool_tab_controls"
                        android:text="@string/modern_convenient_control"
                        android:drawableStart="@drawable/modern_nav_gestures"
                        style="@style/ModernNavItem"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <View
        android:background="@color/modern_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/modern_content_background"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/modern_text"
                android:id="@+id/modern_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/modern_home"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:background="@color/modern_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <FrameLayout
            android:id="@+id/modern_section_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/modern_section_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/fragment_modern_home"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/modern_section_startup"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/fragment_modern_startup"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/modern_section_hud"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/fragment_modern_hud"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/modern_section_comfort"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/fragment_modern_comfort"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/modern_section_tools"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/fragment_modern_tools"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
