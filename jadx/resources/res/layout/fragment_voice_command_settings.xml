<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_engine_title"/>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/radioVoiceEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/radioVoiceEngineSimple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_engine_simple"/>
            <RadioButton
                android:id="@+id/radioVoiceEngineAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_engine_advanced"/>
            <RadioButton
                android:id="@+id/radioVoiceEngineFree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_engine_free"/>
        </RadioGroup>
        <Button
            android:id="@+id/btnApplyVoiceEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_engine_apply"/>
        <TextView
            android:id="@+id/textVoiceEngineStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_recognition_language"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Spinner
                android:id="@+id/spinnerVoskLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dialog"/>
            <Button
                android:id="@+id/btnApplyVoskLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/apply_vosk_model"/>
        </LinearLayout>
        <TextView
            android:id="@+id/textVoskModelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vosk_default_model_hint"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btnAddCommand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dobavit"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:id="@+id/textView49"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_spi_help"/>
        <Switch
            android:id="@+id/spi_aktivate_sw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/spi_aktivate_sw"/>
        <EditText
            android:id="@+id/editActivationPhrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pom_activatia"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerVoiceCommands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
