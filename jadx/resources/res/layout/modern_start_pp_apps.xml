<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp">
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/app_to_pri"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <FrameLayout
                    android:background="@drawable/modern_field"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <Spinner
                        android:id="@+id/spinner5"
                        style="@style/ModernGestureSpinner"/>
                    <ImageView style="@style/ModernGestureDropIcon"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">
                <Button
                    android:id="@+id/button"
                    android:text="@string/b_start_pp"
                    style="@style/ModernSplitButton"/>
                <Button
                    android:id="@+id/button2"
                    android:text="@string/b_start_gu"
                    android:layout_marginStart="10dp"
                    style="@style/ModernSplitButton"/>
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch1"
                android:text="@string/sw_boot"
                style="@style/ModernMapSwitchRow"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_AppPPFullscreen"
                android:layout_marginBottom="0dp"
                android:text="@string/sw_app_pp_fullscreen"
                style="@style/ModernMapSwitchRow"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
