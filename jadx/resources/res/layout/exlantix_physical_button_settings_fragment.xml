<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="450dp">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabsPhysicalButtonTypes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:contentDescription="Тип физических кнопок"/>
    <ImageView
        android:id="@+id/imagePhysicalButtonState"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:src="@drawable/exlantix_physical_buttons"
        android:scaleType="centerCrop"
        android:contentDescription="Физические кнопки"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:id="@+id/textPhysicalButtonPairTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Кнопки не сопряжены"/>
    <TextView
        android:id="@+id/textPhysicalButtonPairStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Состояние не проверено"/>
    <Button
        android:id="@+id/btnStartPhysicalButtonPairing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Сопрячь кнопки"/>
    <Button
        android:id="@+id/btnStopPhysicalButtonPairing"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Остановить сопряжение"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/physicalKnobSettings"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exlantix_knob_left"
                    android:labelFor="@+id/spinnerPhysicalKnobLeft"/>
                <Spinner
                    android:id="@+id/spinnerPhysicalKnobLeft"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exlantix_knob_right"
                    android:labelFor="@+id/spinnerPhysicalKnobRight"/>
                <Spinner
                    android:id="@+id/spinnerPhysicalKnobRight"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exlantix_knob_hint"/>
    </LinearLayout>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:id="@+id/textPhysicalButtonCommandsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Назначения кнопок"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/textLastPhysicalButtonEvent"
        android:background="@drawable/uni_field_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="132dp"
        android:minHeight="48dp"
        android:text="Последняя кнопка: нет"
        android:maxLines="2"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPhysicalButtonCommands"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"/>
    <Button
        android:id="@+id/btnUseLastPhysicalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавить нажатую кнопку"/>
    <Button
        android:id="@+id/btnSavePhysicalButtonCommands"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save"/>
</LinearLayout>
