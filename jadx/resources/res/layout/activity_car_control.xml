<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.NaviStart.AppBarOverlay"
    android:gravity="center"
    android:id="@+id/carcontrolactivity"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/la_fon3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp">
            <RelativeLayout
                android:layout_gravity="start"
                android:background="@drawable/la_fon2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/textView34"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:text=""/>
            </RelativeLayout>
            <com.google.android.flexbox.FlexboxLayout
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="30dp"
                app:alignContent="center"
                app:alignItems="center"
                app:flexWrap="wrap"
                app:justifyContent="center">
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/heating_left_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="1"
                    app:buttonMode_text="1"
                    app:buttonText="@string/b_left"
                    app:button_view_ico="@drawable/car_seat_heat_l2"/>
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/vent_left_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="1"
                    app:buttonMode_text="1"
                    app:buttonText="@string/b_left"
                    app:button_view_ico="@drawable/car_seat_vent_l2"/>
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/heating_right_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="1"
                    app:buttonMode_text="1"
                    app:buttonText="@string/b_right"
                    app:button_view_ico="@drawable/car_seat_heat_r2"/>
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/vent_right_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="1"
                    app:buttonMode_text="1"
                    app:buttonText="@string/b_right"
                    app:button_view_ico="@drawable/car_seat_vent_r2"/>
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/heat_vil_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="0"
                    app:buttonMode_text="1"
                    app:buttonText="@string/rul"
                    app:button_view_ico="@drawable/car_heat_wheel"/>
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/heat_lob_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="0"
                    app:buttonMode_text="1"
                    app:buttonText="@string/b_per"
                    app:button_view_ico="@drawable/car_windshield_heat2"/>
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/heat_zad_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="0"
                    app:buttonMode_text="1"
                    app:buttonText="@string/b_zad"
                    app:button_view_ico="@drawable/car_rearwindow_heat2"/>
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/heat_zad_seat_l_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="1"
                    app:buttonMode_text="1"
                    app:buttonText="@string/b_left_zad"
                    app:button_view_ico="@drawable/car_seat_heat_l"/>
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/vent_zad_seat_l_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="1"
                    app:buttonMode_text="1"
                    app:buttonText="@string/b_left_zad"
                    app:button_view_ico="@drawable/car_seat_vent_l2"/>
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/heat_zad_seat_r_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="1"
                    app:buttonMode_text="1"
                    app:buttonText="@string/b_right_zad"
                    app:button_view_ico="@drawable/car_seat_heat_r"/>
                <com.example.navistart.mainview.HeatingButtonView
                    android:id="@+id/vent_zad_seat_r_button_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:buttonMode="1"
                    app:buttonMode_text="1"
                    app:buttonText="@string/b_right_zad"
                    app:button_view_ico="@drawable/car_seat_vent_r2"/>
            </com.google.android.flexbox.FlexboxLayout>
            <Button
                android:id="@+id/button22"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="Закрыть"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
