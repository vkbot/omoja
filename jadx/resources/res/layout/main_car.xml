<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainCarPrefViewLabel"
            android:background="@color/header"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            android:layout_marginTop="0dp"
            android:shadowColor="@color/headerTextShadowColor"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:background="@drawable/border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.flexbox.FlexboxLayout
                android:background="@color/FlexboxLayout_MainView"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp"
                app:alignContent="flex_start"
                app:alignItems="flex_start"
                app:flexWrap="wrap">
                <LinearLayout
                    android:padding="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp">
                    <ImageView
                        android:background="@drawable/baseline_directions_car_24"
                        android:layout_width="@dimen/layout_height_constant"
                        android:layout_height="@dimen/layout_height_constant"
                        android:layout_marginRight="8dp"/>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:background="@drawable/border_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/layout_height_constant"
                        android:layout_column="1"
                        android:layout_row="0">
                        <FrameLayout
                            android:background="@drawable/border_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <Spinner
                                android:textSize="30sp"
                                android:gravity="center"
                                android:id="@+id/spinner26"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="5dp"
                                android:minHeight="@dimen/layout_height_constant"
                                android:popupBackground="@color/dropDownsBackground"/>
                            <ImageView
                                android:layout_gravity="end|center_vertical"
                                android:layout_width="40dp"
                                android:layout_height="@dimen/layout_height_constant"
                                android:src="@mipmap/drop"
                                android:layout_marginEnd="8dp"/>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
