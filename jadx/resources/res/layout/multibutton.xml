<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/centerImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/multi_button_core"/>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/imgTop"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginBottom="220dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/multi_button_vspom"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/badgeTop"
            android:layout_width="@dimen/Image_badge_size"
            android:layout_height="@dimen/Image_badge_size"
            android:layout_margin="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/imgBottom"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="220dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/multi_button_vspom"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/badgeBottom"
            android:layout_width="@dimen/Image_badge_size"
            android:layout_height="@dimen/Image_badge_size"
            android:layout_margin="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/imgLeft"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="110dp"
        android:layout_marginRight="220dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/multi_button_vspom"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/badgeLeft"
            android:layout_width="@dimen/Image_badge_size"
            android:layout_height="@dimen/Image_badge_size"
            android:layout_margin="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/imgRight"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginLeft="220dp"
        android:layout_marginTop="110dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/multi_button_vspom"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/badgeRight"
            android:layout_width="@dimen/Image_badge_size"
            android:layout_height="@dimen/Image_badge_size"
            android:layout_margin="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/imgTopLeft"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:translationX="-85dp"
        android:translationY="-85dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/multi_button_vspom"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/badgeTopLeft"
            android:layout_width="@dimen/Image_badge_size"
            android:layout_height="@dimen/Image_badge_size"
            android:layout_margin="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/imgTopRight"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:translationX="85dp"
        android:translationY="-85dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/multi_button_vspom"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/badgeTopRight"
            android:layout_width="@dimen/Image_badge_size"
            android:layout_height="@dimen/Image_badge_size"
            android:layout_margin="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/imgBottomLeft"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:translationX="-85dp"
        android:translationY="85dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/multi_button_vspom"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/badgeBottomLeft"
            android:layout_width="@dimen/Image_badge_size"
            android:layout_height="@dimen/Image_badge_size"
            android:layout_margin="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/imgBottomRight"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:translationX="85dp"
        android:translationY="85dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/multi_button_vspom"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/badgeBottomRight"
            android:layout_width="@dimen/Image_badge_size"
            android:layout_height="@dimen/Image_badge_size"
            android:layout_margin="4dp"/>
    </FrameLayout>
</FrameLayout>
