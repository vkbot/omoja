<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/back_Frame_speedBoard"
    android:background="#e0e0e0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:layout_gravity="center"
                    android:id="@+id/speedLimitBlock"
                    android:visibility="invisible"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/speedSignImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_speed_sign"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/speed_sign_image_desc"/>
                    <TextView
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:id="@+id/speedLimitText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <ImageView
                    android:id="@+id/man_img_view"
                    android:background="#30000000"
                    android:visibility="invisible"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    app:srcCompat="@drawable/notification_left_sdl"/>
                <TextView
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/rast_man"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/rast_finish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_weight="1"/>
            </LinearLayout>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/relativeLayout32"
            android:layout_width="110dp"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="60dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/textspeedwidg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="120"
                android:fontFamily="@font/plup"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/CamAlarm"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/cameraImage"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/camera_alarm_show"
                    android:contentDescription="@string/camera_image_desc"/>
                <RelativeLayout
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp">
                    <ImageView
                        android:id="@+id/CamspeedSignImage"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@drawable/ic_speed_sign"
                        android:contentDescription="@string/speed_sign_image_desc"/>
                    <TextView
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:id="@+id/CamspeedLimitText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <TextView
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/cameraDis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
