<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/modern_background"
    android:scrollbars="vertical"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <Button
                android:id="@+id/cancelinstallApkButton"
                android:layout_width="132dp"
                android:text="@string/b_back"
                android:layout_marginEnd="20dp"
                style="@style/ModernInlineButton"/>
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/modern_text"
                android:id="@+id/textView37"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/vib_pri_del"
                android:layout_weight="1"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/modern_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/installApkButton"
                    android:text="@string/install_apk"
                    style="@style/ModernWideButton"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/manageAppsAdvancedActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <Button
                        android:id="@+id/grantAppPermissionsButton"
                        android:text="@string/app_permission_grant_title"
                        android:layout_marginEnd="5dp"
                        style="@style/ModernSplitButton"/>
                    <Button
                        android:id="@+id/carPackageToggleButton"
                        android:text="@string/car_package_toggle_title"
                        android:layout_marginStart="5dp"
                        style="@style/ModernSplitButton"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/modern_text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/vib_pri_del"/>
        <com.woha.appmanag.ExpandableHeightListView
            android:id="@+id/listView"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
