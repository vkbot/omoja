<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/modern_action_row"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginBottom="6dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <ImageView
        android:id="@+id/imageZone"
        android:padding="3dp"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/modern_text"
        android:id="@+id/textZoneName"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="14dp"/>
    <FrameLayout
        android:background="@drawable/modern_field"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <Spinner
            android:gravity="center_vertical"
            android:id="@+id/zoneSpinner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:popupBackground="@color/modern_surface_high"
            android:spinnerMode="dialog"
            android:paddingStart="16dp"
            android:paddingEnd="44dp"/>
        <ImageView
            android:layout_gravity="end"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:src="@mipmap/drop"
            android:contentDescription="@null"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
    <CheckBox
        android:textSize="15sp"
        android:textColor="@color/modern_text"
        android:gravity="center_vertical"
        android:id="@+id/zoneCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:text="@string/b_On"
        android:layout_marginStart="14dp"
        android:buttonTint="@color/modern_primary"/>
</LinearLayout>
