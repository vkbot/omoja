<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/modern_background"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <Button
                android:id="@+id/button28"
                android:layout_width="132dp"
                android:text="@string/b_back"
                android:layout_marginEnd="20dp"
                style="@style/ModernInlineButton"/>
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/jct_ico_settings"
                android:contentDescription="@string/launcher_shortcut_update"
                android:layout_marginEnd="14dp"/>
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/modern_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/launcher_shortcut_update"
                android:layout_weight="1"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/modern_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/modern_text"
                    android:gravity="center_vertical"
                    android:id="@+id/currentVersionTextView"
                    android:background="@drawable/modern_action_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="58dp"
                    android:text="@string/launcher_shortcut_update"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/modern_text_secondary"
                    android:id="@+id/availableVersionTextView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:progress="0"
                    android:progressTint="@color/modern_primary"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <Button
                    android:id="@+id/updateButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/install_jct_b"
                    style="@style/ModernWideButton"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/modern_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/launcherShortcutsButton"
                    android:text="@string/launcher_shortcuts_button"
                    style="@style/ModernWideButton"/>
                <Button
                    android:id="@+id/updateButton2"
                    android:text="@string/install_app_b"
                    style="@style/ModernWideButton"/>
                <LinearLayout
                    android:background="@drawable/modern_action_row"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <Switch
                        android:textSize="16sp"
                        android:textColor="@color/modern_text"
                        android:gravity="center_vertical"
                        android:id="@+id/switch22"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:text="@string/sw_black_top_auto_click_install"/>
                </LinearLayout>
                <Button
                    android:enabled="false"
                    android:id="@+id/button18"
                    android:visibility="gone"
                    android:text="@string/install_beta"
                    style="@style/ModernWideButton"/>
                <Button
                    android:id="@+id/button_testNS_install"
                    android:visibility="gone"
                    android:text="@string/install_beta_test"
                    style="@style/ModernWideButton"/>
                <Switch
                    android:enabled="false"
                    android:textSize="16sp"
                    android:textColor="@color/modern_text"
                    android:id="@+id/switch21"
                    android:background="@drawable/modern_action_row"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="@string/beta_test_pro"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"/>
                <Button
                    android:enabled="false"
                    android:id="@+id/resetAndUpdateButton"
                    android:visibility="gone"
                    android:text="@string/app_permission_grant_title"
                    style="@style/ModernWideButton"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/modern_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Switch
                    android:textSize="16sp"
                    android:textColor="@color/modern_text"
                    android:gravity="center_vertical"
                    android:id="@+id/switch16"
                    android:background="@drawable/modern_safety_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:text="@string/clear_data_sw"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp"/>
                <Button
                    android:enabled="false"
                    android:id="@+id/clearDataButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/clear_data"
                    style="@style/ModernDangerWideButton"/>
                <Button
                    android:enabled="false"
                    android:id="@+id/DelAppButton"
                    android:text="@string/del_app"
                    style="@style/ModernDangerWideButton"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
