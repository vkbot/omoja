<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_launcher_theme_card"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="7dp"
    android:elevation="3dp">
    <ImageView
        android:id="@+id/imgPreview"
        android:background="@drawable/bg_launcher_theme_preview"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#f4f7fa"
        android:ellipsize="end"
        android:id="@+id/txtName"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:maxLines="2"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#9baaba"
        android:ellipsize="end"
        android:id="@+id/txtType"
        android:paddingTop="4dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <Button
        android:textSize="15sp"
        android:textColor="@color/permission_button_text"
        android:layout_gravity="center"
        android:id="@+id/down"
        android:background="@drawable/modern_button_primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="0dp"
        android:text="@string/download"
        android:textAllCaps="false"
        android:backgroundTint="@null"/>
</LinearLayout>
