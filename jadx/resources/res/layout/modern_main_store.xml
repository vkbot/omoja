<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">
            <Button
                android:id="@+id/JCT_Store_app"
                android:text="@string/JCT_Store_app_app_b"
                android:drawableStart="@mipmap/jct_store_icon"
                style="@style/ModernStoreActionRow"/>
            <Button
                android:id="@+id/JCT_File_Manager"
                android:layout_marginBottom="18dp"
                android:text="@string/user_file_manager_button"
                android:drawableStart="@mipmap/jct_file_icon"
                style="@style/ModernStoreActionRow"/>
            <Button
                android:id="@+id/JCT_Video_Library"
                android:text="@string/video_library"
                android:drawableStart="@drawable/ic_jct_video"
                style="@style/ModernStoreActionRow"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/lay_black_top_auto_click_install"
                android:background="@drawable/modern_action_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:minHeight="76dp"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:id="@+id/ind_black_top_auto_click_install"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/modern_store_autoclick"
                    android:contentDescription="@null"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/modern_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sw_black_top_auto_click_install"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <View
                            android:id="@+id/modern_install_service_indicator"
                            android:background="@drawable/modern_status_dot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/modern_text_secondary"
                            android:id="@+id/modern_install_service_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/modern_service_stopped"
                            android:layout_marginStart="7dp"/>
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_black_top_auto_click_install"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/sw_black_top_auto_click_install"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            <Button
                android:id="@+id/modern_grant_app_permissions"
                android:text="@string/app_permission_grant_title"
                android:drawableStart="@drawable/modern_store_permissions"
                style="@style/ModernStoreActionRow"/>
            <Button
                android:id="@+id/modern_fullscreen_apps"
                android:text="@string/fullscreen_apps_title"
                android:drawableStart="@drawable/ic_fullscreen_apps"
                style="@style/ModernStoreActionRow"/>
            <Button
                android:id="@+id/modern_car_package_toggle"
                android:text="@string/car_package_toggle_title"
                android:drawableStart="@drawable/modern_store_car_packages"
                style="@style/ModernStoreActionRow"/>
            <Button
                android:id="@+id/JCT_User_Apps_Hide"
                android:text="@string/user_apps_hide_button"
                android:drawableStart="@drawable/modern_store_hidden_apps"
                style="@style/ModernStoreActionRow"/>
            <Button
                android:id="@+id/install_unistall_app"
                android:text="@string/install_app_b"
                android:drawableStart="@drawable/modern_store_manage_apps"
                style="@style/ModernStoreActionRow"/>
            <LinearLayout
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/install_AuroraStore"
                    android:text="@string/b_install_Aurora_Store"
                    style="@style/ModernStoreActionRow"/>
                <Button
                    android:id="@+id/install_AptoideStore"
                    android:text="@string/b_install_Aptoide_Store"
                    style="@style/ModernStoreActionRow"/>
                <Button
                    android:id="@+id/install_RuStore"
                    android:text="@string/b_install_RuStore"
                    style="@style/ModernStoreActionRow"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
