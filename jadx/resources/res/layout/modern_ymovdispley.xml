<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/modern_action_row"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imgResurceMove"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/modern_text"
                android:id="@+id/NameLayMov"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/modern_slider_x_row"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/modern_text_secondary"
                android:id="@+id/modern_slider_x_label"
                android:layout_width="122dp"
                android:layout_height="wrap_content"
                android:text="@string/modern_map_horizontal"/>
            <SeekBar
                android:id="@+id/modern_slider_x"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:max="3000"
                android:progressDrawable="@drawable/modern_map_slider_track"
                android:minHeight="52dp"
                android:thumb="@drawable/modern_map_slider_thumb"
                android:thumbOffset="17dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:splitTrack="false"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/modern_primary"
                android:gravity="center"
                android:id="@+id/modern_slider_x_value"
                android:background="@drawable/modern_field"
                android:layout_width="82dp"
                android:layout_height="46dp"
                android:layout_marginStart="14dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/modern_slider_y_row"
            android:layout_width="match_parent"
            android:layout_height="68dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/modern_text_secondary"
                android:layout_width="122dp"
                android:layout_height="wrap_content"
                android:text="@string/modern_map_vertical"/>
            <SeekBar
                android:id="@+id/modern_slider_y"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:max="3000"
                android:progressDrawable="@drawable/modern_map_slider_track"
                android:minHeight="52dp"
                android:thumb="@drawable/modern_map_slider_thumb"
                android:thumbOffset="17dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:splitTrack="false"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/modern_primary"
                android:gravity="center"
                android:id="@+id/modern_slider_y_value"
                android:background="@drawable/modern_field"
                android:layout_width="82dp"
                android:layout_height="46dp"
                android:layout_marginStart="14dp"/>
        </LinearLayout>
        <LinearLayout
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/movL"
                android:layout_width="1dp"
                android:layout_height="1dp"/>
            <ImageButton
                android:id="@+id/movR"
                android:layout_width="1dp"
                android:layout_height="1dp"/>
            <ImageButton
                android:id="@+id/movU"
                android:layout_width="1dp"
                android:layout_height="1dp"/>
            <ImageButton
                android:id="@+id/movD"
                android:layout_width="1dp"
                android:layout_height="1dp"/>
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/YLayMovX"
                android:layout_width="1dp"
                android:layout_height="1dp"/>
            <TextView
                android:id="@+id/textView40"
                android:layout_width="1dp"
                android:layout_height="1dp"/>
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/YLayMovY"
                android:layout_width="1dp"
                android:layout_height="1dp"/>
        </LinearLayout>
    </LinearLayout>
</merge>
