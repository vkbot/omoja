<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/ModernSettingsActionContainer">
    <ImageView
        android:src="@drawable/ic_fuel_tank"
        android:tint="@color/modern_primary"
        android:contentDescription="@null"
        style="@style/ModernSettingsRowIcon"/>
    <com.google.android.material.materialswitch.MaterialSwitch
        android:gravity="start|center_vertical"
        android:id="@+id/AllWidgetServices_FuelRemainingView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/fuel_widget_title"
        android:layout_weight="1"
        android:layoutDirection="rtl"
        android:layout_marginStart="10dp"/>
    <Button
        android:id="@+id/fuel_widget_settings"
        android:text="@string/fuel_widget_capacity_button"
        android:layout_marginStart="10dp"
        style="@style/ModernInlineButton"/>
</LinearLayout>
