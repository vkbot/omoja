<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp">
            <TextView
                android:text="@string/modern_system_voice_assistant"
                style="@style/ModernGroupTitle"/>
            <LinearLayout
                android:id="@+id/lay_fiksik_on_off"
                style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/fiksik_ico"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/sw_fiksik_on_off"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/modern_system_voice_assistant_disable"
                    android:maxLines="2"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
                <Button
                    android:id="@+id/b_fiksik_on"
                    android:layout_width="90dp"
                    android:minWidth="0dp"
                    android:text="@string/b_On"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="8dp"
                    style="@style/ModernInlineButton"/>
                <Button
                    android:id="@+id/b_fiksik_off"
                    android:layout_width="90dp"
                    android:minWidth="0dp"
                    android:text="@string/b_Off"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="6dp"
                    style="@style/ModernInlineButton"/>
            </LinearLayout>
            <TextView
                android:layout_marginTop="16dp"
                android:text="@string/modern_system_multimedia"
                style="@style/ModernGroupTitle"/>
            <LinearLayout
                android:id="@+id/lay_autolink_mediadebug"
                style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/music"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/sw_autolink_mediadebug"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/modern_system_autolink_audio"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lay_omoda_steering_media_control"
                android:visibility="gone"
                style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/omoda_steering_media_disabled"
                    android:contentDescription="@string/omoda_disable_steering_media_control"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/sw_omoda_disable_steering_media_control"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/omoda_disable_steering_media_control"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
