<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/MemInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MemInfo"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/button32"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Threads"
            android:layout_weight="1"/>
        <Switch
            android:id="@+id/spi_all_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spi_all_off"/>
        <EditText
            android:id="@+id/spi_chane"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:ems="11"
            android:layout_weight="1"
            android:inputType="number"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Switch
            android:id="@+id/spi_JCTProxy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spi_JCTProxy"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/button33"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/bhudon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HUD On"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/bhudoff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HUD Off"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/button34"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DisplayInfo"/>
        <Button
            android:id="@+id/button_split"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Split"/>
        <Button
            android:id="@+id/button13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Запустить на дисплее:"/>
        <EditText
            android:id="@+id/editTextNumber2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:ems="10"
            android:layout_weight="1"
            android:inputType="number"/>
        <Button
            android:id="@+id/button24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Активировать ПП"/>
        <EditText
            android:id="@+id/editTextNumber3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:ems="10"
            android:layout_weight="1"
            android:inputType="number"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/textView33"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Neusoft Displey mode"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <EditText
                android:id="@+id/editTextNumber4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:ems="1"
                android:layout_weight="1"
                android:inputType="number"/>
            <EditText
                android:id="@+id/editTextNumber5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:ems="1"
                android:layout_weight="1"
                android:inputType="number"/>
            <Button
                android:id="@+id/neu_pp_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
