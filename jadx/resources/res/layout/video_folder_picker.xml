<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/modern_surface_high"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/videoFolderDevice"
            android:layout_width="0dp"
            android:text="@string/video_device"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/VideoLibraryButton"/>
        <Button
            android:id="@+id/videoFolderUsb"
            android:layout_width="wrap_content"
            android:text="USB"
            style="@style/VideoLibraryButton"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/modern_text_secondary"
        android:ellipsize="middle"
        android:gravity="center_vertical"
        android:id="@+id/videoFolderPath"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:maxLines="3"
        android:paddingVertical="8dp"/>
    <ListView
        android:id="@+id/videoFolderList"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"/>
</LinearLayout>
