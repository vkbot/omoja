<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp">
            <TextView
                android:text="@string/modern_widgets_display"
                style="@style/ModernGroupTitle"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/widgets_over_system"
                android:text="@string/widgets_over_system"
                style="@style/ModernMapSwitchRow"/>
            <TextView
                android:layout_marginTop="16dp"
                android:text="@string/modern_widgets_information"
                style="@style/ModernGroupTitle"/>
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/widg_ico2"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/sw_pogoda_widg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/sw_pogoda_widg"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
                <FrameLayout
                    android:background="@drawable/modern_field"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp">
                    <Spinner
                        android:id="@+id/spinner_pogoda_widg"
                        style="@style/ModernGestureSpinner"/>
                    <ImageView style="@style/ModernGestureDropIcon"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/ico_clock1"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/AllWidgetServices_dClock"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/sw_Clock_View"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/temperature_view1"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/AllWidgetServices_TemperaturaMashView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/sw_TemperaturaMash_View"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <include layout="@layout/fuel_widget_control"/>
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/clipboard"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/AllWidgetServices_StorageFreeView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/sw_StorageFree_View"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <TextView
                android:layout_marginTop="16dp"
                android:text="@string/modern_widgets_network"
                style="@style/ModernGroupTitle"/>
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/vpn_ico"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/VJCT_Service_View_visible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/sw_VPN_View"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
                <Button
                    android:id="@+id/VJCT_Service_settings"
                    android:text="@string/b_settings_vpn"
                    android:layout_marginStart="10dp"
                    style="@style/ModernInlineButton"/>
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/AllWidgetServices_MediaControlView"
                android:visibility="gone"
                android:text="@string/sw_MediaControlView_View"
                style="@style/ModernMapSwitchRow"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
