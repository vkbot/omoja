<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/modern_background"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="64dp">
        <Button
            android:id="@+id/button28"
            android:layout_width="132dp"
            android:text="@string/b_back"
            android:layout_marginEnd="20dp"
            style="@style/ModernInlineButton"/>
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/modern_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/launcher_shortcut_update"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/modern_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@mipmap/jct_ico_settings"
                android:contentDescription="@string/launcher_shortcut_update"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/modern_text"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/install_jct_b"/>
            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:indeterminateTint="@color/modern_primary"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
