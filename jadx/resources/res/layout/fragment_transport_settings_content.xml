<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/transportBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/b_back"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/transport_settings_title"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/transport_description"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?android:attr/colorBackground"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <View
            android:id="@+id/transportStatusIndicator"
            android:background="@drawable/mock_gps_status_offline"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/transportStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/transport_not_started"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?android:attr/colorBackground"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <ImageView
            android:id="@+id/transportPhoneAppQr"
            android:background="?android:attr/colorBackground"
            android:padding="4dp"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/transport_phone_app_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transport_phone_app_title"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/transport_phone_app_subtitle"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/transport_wifi_title"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/transport_wifi_description"/>
    <com.google.android.material.materialswitch.MaterialSwitch
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/transportAutomaticWifi"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/transport_wifi_automatic"/>
    <EditText
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:id="@+id/transportHost"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="@string/transport_wifi_ip_hint"
        android:maxLines="1"
        android:inputType="textUri"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/transport_bluetooth_title"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/transport_bluetooth_description"/>
    <Spinner
        android:id="@+id/transportBluetoothDevice"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:spinnerMode="dialog"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/transport_shared_token"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/transport_token_description"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <EditText
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:id="@+id/transportToken"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:hint="@string/transport_token_hint"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="number"/>
        <Button
            android:id="@+id/transportGenerateToken"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:text="@string/transport_generate_token"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <Button
        android:id="@+id/transportSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/transport_save"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <Button
            android:id="@+id/transportStart"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:text="@string/transport_manual_start"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"/>
        <Button
            android:id="@+id/transportStop"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:text="@string/transport_manual_stop"
            android:layout_weight="1"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
</LinearLayout>
