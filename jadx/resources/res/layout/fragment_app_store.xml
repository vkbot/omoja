<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/modern_background"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/storeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <Button
            android:id="@+id/storeBackButton"
            android:layout_width="132dp"
            android:text="@string/b_back"
            android:layout_marginEnd="12dp"
            style="@style/ModernInlineButton"/>
        <Button
            android:id="@+id/storeManageAppsButton"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/install_app_b"
            android:layout_weight="1"
            style="@style/ModernInlineButton"/>
    </LinearLayout>
    <EditText
        android:textSize="17sp"
        android:textColor="@color/modern_text"
        android:textColorHint="@color/modern_text_secondary"
        android:id="@+id/storeSearchInput"
        android:background="@drawable/modern_field"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:hint="@string/app_store_search_hint"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/modern_text_secondary"
        android:gravity="center"
        android:id="@+id/storeCatalogStatus"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/app_store_catalog_unavailable"
        android:layout_weight="1"/>
</LinearLayout>
