<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            android:layout_marginTop="0dp"
            android:shadowColor="@color/headerTextShadowColor"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:background="@drawable/border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.flexbox.FlexboxLayout
                android:background="@color/FlexboxLayout_MainView"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp"
                app:alignContent="flex_start"
                app:alignItems="flex_start"
                app:flexWrap="wrap"
                app:justifyContent="center">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/layout_height_constant"
                    android:layout_height="@dimen/layout_height_constant"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp">
                    <ImageView
                        android:background="@drawable/rounded_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/auto_vod_ico"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:textSize="@dimen/layout_text_constant"
                    android:textColor="@color/black"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/switch15"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/layout_height_constant"
                    android:text="@string/sw_vod_blu"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <FrameLayout
                    android:background="@drawable/border_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/layout_height_constant">
                    <Spinner
                        android:textSize="20sp"
                        android:gravity="center"
                        android:id="@+id/spinner13"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:popupBackground="@color/dropDownsBackground"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="40dp"
                        android:layout_height="@dimen/layout_height_constant"
                        android:src="@mipmap/drop"
                        android:layout_marginEnd="8dp"/>
                </FrameLayout>
                <ImageView
                    android:id="@+id/modern_driver_mapping_arrow"
                    android:layout_width="@dimen/layout_height_constant"
                    android:layout_height="@dimen/layout_height_constant"
                    android:src="@drawable/left"
                    android:rotation="90"/>
                <FrameLayout
                    android:background="@drawable/border_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/layout_height_constant">
                    <Spinner
                        android:textSize="20sp"
                        android:gravity="center"
                        android:id="@+id/spinner14"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:popupBackground="@color/dropDownsBackground"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="40dp"
                        android:layout_height="@dimen/layout_height_constant"
                        android:src="@mipmap/drop"
                        android:layout_marginEnd="8dp"/>
                </FrameLayout>
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
