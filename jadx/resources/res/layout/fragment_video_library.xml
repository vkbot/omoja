<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/modern_background"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <HorizontalScrollView
        android:scrollbarStyle="outsideInset"
        android:scrollbars="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fillViewport="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/videoBack"
                android:text="@string/b_back"
                android:layout_marginEnd="8dp"
                style="@style/VideoToolbarButton"/>
            <Button
                android:id="@+id/videoSource"
                android:text="@string/video_source"
                android:layout_marginEnd="8dp"
                style="@style/VideoToolbarButton"/>
            <Button
                android:id="@+id/videoFolder"
                android:text="@string/video_choose_folder"
                android:layout_marginEnd="8dp"
                style="@style/VideoToolbarButton"/>
            <Button
                android:id="@+id/videoRefresh"
                android:text="@string/video_refresh"
                style="@style/VideoToolbarButton"/>
        </LinearLayout>
    </HorizontalScrollView>
    <TextView
        android:textColor="@color/modern_text_secondary"
        android:ellipsize="middle"
        android:id="@+id/videoSourceLabel"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"/>
    <EditText
        android:textColor="@color/modern_text"
        android:textColorHighlight="@color/modern_primary_dark"
        android:textColorHint="@color/modern_text_secondary"
        android:id="@+id/videoSearch"
        android:background="@drawable/modern_field"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="@string/video_search"
        android:singleLine="true"
        android:inputType="text"
        android:backgroundTint="@null"
        android:paddingHorizontal="16dp"
        app:backgroundTint="@null"/>
    <TextView
        android:textColor="@color/modern_text_secondary"
        android:id="@+id/videoStatus"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/videoGrid"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
