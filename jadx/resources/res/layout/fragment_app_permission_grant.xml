<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="420dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">
        <Button
            android:id="@+id/permissionGrantBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/b_back"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/permissionGrantTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_permission_grant_title"
            android:layout_weight="1"/>
        <View
            android:id="@+id/permissionGrantAccessIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/app_permission_grant_select_app"/>
    <Spinner
        android:id="@+id/permissionGrantAppSpinner"
        android:background="@drawable/uni_field_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:minHeight="72dp"
        android:prompt="@string/app_permission_grant_select_app"
        android:spinnerMode="dialog"/>
    <Button
        android:textSize="16sp"
        android:id="@+id/permissionGrantButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/app_permission_grant_all"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/permissionGrantStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
</LinearLayout>
