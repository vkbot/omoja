<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            android:layout_marginTop="0dp"
            android:shadowColor="@color/headerTextShadowColor"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:background="@drawable/border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lay_fiksik_on_off"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/layout_height_constant"
                        android:layout_height="@dimen/layout_height_constant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/fiksik_ico"/>
                    </androidx.cardview.widget.CardView>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center"
                        android:id="@+id/sw_fiksik_on_off"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/layout_height_constant"
                        android:text="@string/sw_fiksik"
                        android:layout_weight="1"
                        android:layoutDirection="rtl"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                    <Button
                        android:layout_gravity="center"
                        android:id="@+id/b_fiksik_on"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/b_On"/>
                    <Button
                        android:layout_gravity="center"
                        android:id="@+id/b_fiksik_off"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/b_Off"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lay_autolink_mediadebug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/layout_height_constant"
                        android:layout_height="@dimen/layout_height_constant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/music"/>
                    </androidx.cardview.widget.CardView>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center"
                        android:id="@+id/sw_autolink_mediadebug"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/sw_autolink_mediadebug"
                        android:layout_weight="1"
                        android:layoutDirection="rtl"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/lay_exlantix_physical_buttons"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/layout_height_constant"
                        android:layout_height="@dimen/layout_height_constant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/exlantix_physical_buttons"
                            android:scaleType="centerCrop"
                            android:translationX="85dp"
                            android:translationY="2dp"
                            android:scaleX="4.65"
                            android:scaleY="4.65"/>
                    </androidx.cardview.widget.CardView>
                    <Button
                        android:layout_gravity="center"
                        android:id="@+id/button_exlantix_physical_buttons_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/exlantix_physical_buttons_settings"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/lay_omoda_steering_media_control"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/layout_height_constant"
                        android:layout_height="@dimen/layout_height_constant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp">
                        <ImageView
                            android:padding="7dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/omoda_steering_media_disabled"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/omoda_disable_steering_media_control"/>
                    </androidx.cardview.widget.CardView>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center"
                        android:id="@+id/sw_omoda_disable_steering_media_control"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/omoda_disable_steering_media_control"
                        android:layout_weight="1"
                        android:layoutDirection="rtl"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/lay_log_keycode_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/layout_height_constant"
                        android:layout_height="@dimen/layout_height_constant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp">
                        <ImageView
                            android:padding="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/log_keycode_settings"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/log_keycode_settings_button"/>
                    </androidx.cardview.widget.CardView>
                    <Button
                        android:layout_gravity="center"
                        android:id="@+id/button_log_keycode_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/log_keycode_settings_button"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/lay_tracker_map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/layout_height_constant"
                        android:layout_height="@dimen/layout_height_constant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/icon_map_235861"/>
                    </androidx.cardview.widget.CardView>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center"
                        android:id="@+id/sw_tracker_map"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/sw_tracker_map"
                        android:layout_weight="1"
                        android:layoutDirection="rtl"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                    <Button
                        android:id="@+id/b_tracker_map_open"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_map"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/lay_mock_gps_service"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/layout_height_constant"
                        android:layout_height="@dimen/layout_height_constant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/set_navi"/>
                    </androidx.cardview.widget.CardView>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center"
                        android:id="@+id/sw_mock_gps_service"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/mock_gps_autostart"
                        android:layout_weight="1"
                        android:layoutDirection="rtl"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                    <Button
                        android:id="@+id/b_mock_gps_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/b_settings"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
