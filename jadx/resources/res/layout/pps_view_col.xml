<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/back_Frame_speedBoard"
    android:background="@android:color/transparent"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.github.anastr.speedviewlib.ImageSpeedometer
            android:layout_gravity="start|bottom"
            android:id="@+id/imageSpeedometer"
            android:layout_width="600dp"
            android:layout_height="600dp"
            app:sv_backgroundCircleColor="#000"
            app:sv_endDegree="396"
            app:sv_image="@drawable/pri3_spd"
            app:sv_indicator="NeedleIndicator"
            app:sv_indicatorColor="#d51212"
            app:sv_indicatorWidth="15dp"
            app:sv_markHeight="1dp"
            app:sv_maxSpeed="220"
            app:sv_speedTextColor="@android:color/transparent"
            app:sv_speedometerWidth="20dp"
            app:sv_startDegree="135"
            app:sv_trembleDuration="30"
            app:sv_unit=""
            app:sv_withTremble="false"
            sv_indicatorLightColor="#f44336"/>
        <com.github.anastr.speedviewlib.ImageSpeedometer
            android:layout_gravity="end|bottom"
            android:id="@+id/imageSpeedometerrpm"
            android:layout_width="600dp"
            android:layout_height="600dp"
            app:sv_backgroundCircleColor="#000"
            app:sv_endDegree="396"
            app:sv_image="@drawable/pri4_rpm"
            app:sv_indicator="NeedleIndicator"
            app:sv_indicatorColor="#d51212"
            app:sv_indicatorWidth="15dp"
            app:sv_markHeight="1dp"
            app:sv_maxSpeed="8"
            app:sv_speedTextColor="@android:color/transparent"
            app:sv_speedometerWidth="20dp"
            app:sv_startDegree="135"
            app:sv_trembleDuration="30"
            app:sv_unit=""
            app:sv_withTremble="false"
            sv_indicatorLightColor="#f44336"/>
    </FrameLayout>
</RelativeLayout>
