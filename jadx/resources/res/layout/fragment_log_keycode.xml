<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="520dp"
    android:layout_height="650dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/logKeycodeBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/b_back"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/log_keycode_title"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ff7a271a"
        android:background="@drawable/bg_log_keycode_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/log_keycode_warning"
        android:lineSpacingExtra="2dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/log_keycode_filter_label"/>
    <EditText
        android:id="@+id/logKeycodeFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="keycode"
        android:hint="@string/log_keycode_filter_hint"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionDone"/>
    <Button
        android:id="@+id/logKeycodeRecordButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:text="@string/log_keycode_start"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center"
        android:id="@+id/logKeycodeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/log_keycode_status_stopped"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/log_keycode_saved_hint"/>
    <FrameLayout
        android:background="?android:attr/colorBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logKeycodeEvents"
            android:padding="6dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:id="@+id/logKeycodeEmpty"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/log_keycode_empty"/>
    </FrameLayout>
</LinearLayout>
