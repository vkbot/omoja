<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainStartProPriLabel"
            android:background="@color/header"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            android:layout_marginTop="0dp"
            android:shadowColor="@color/headerTextShadowColor"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:background="@drawable/border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.flexbox.FlexboxLayout
                android:background="@color/FlexboxLayout_MainView"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp"
                app:alignContent="center"
                app:alignItems="center"
                app:flexWrap="wrap"
                app:justifyContent="center">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/layout_height_constant"
                    android:layout_height="@dimen/layout_height_constant"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/app_to_pri"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_gravity="center"
                    android:background="@drawable/border_spinner"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/layout_height_constant"
                    android:layout_column="1"
                    android:layout_row="0"
                    app:layout_flexGrow="1">
                    <FrameLayout
                        android:background="@drawable/border_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Spinner
                            android:textSize="20sp"
                            android:gravity="center"
                            android:id="@+id/spinner5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:minHeight="@dimen/layout_height_constant"
                            android:popupBackground="@color/dropDownsBackground"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:layout_width="40dp"
                            android:layout_height="@dimen/layout_height_constant"
                            android:src="@mipmap/drop"
                            android:layout_marginEnd="8dp"/>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp">
                    <Button
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:id="@+id/button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/b_start_pp"/>
                    <Button
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:id="@+id/button2"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:text="@string/b_start_gu"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_gravity="center"
                            android:layout_width="@dimen/layout_height_constant"
                            android:layout_height="@dimen/layout_height_constant"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="4dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/go_to_pp"/>
                        </androidx.cardview.widget.CardView>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:layout_gravity="center"
                            android:id="@+id/switch1"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/layout_height_constant"
                            android:layout_margin="10dp"
                            android:text="@string/sw_boot"
                            android:layoutDirection="rtl"/>
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:id="@+id/sw_AppPPFullscreen"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:layout_margin="10dp"
                        android:text="@string/sw_app_pp_fullscreen"
                        android:layoutDirection="rtl"/>
                    <LinearLayout
                        android:id="@+id/Dashboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_gravity="center"
                            android:layout_width="@dimen/layout_height_constant"
                            android:layout_height="@dimen/layout_height_constant"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="4dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/go_cpp_to_pp"/>
                        </androidx.cardview.widget.CardView>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:layout_gravity="center"
                            android:id="@+id/sw_CustomPPStart"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/layout_height_constant"
                            android:layout_margin="10dp"
                            android:text="@string/sw_CustomPPStart"
                            android:layoutDirection="rtl"/>
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:id="@+id/sw_CustomPPFullscreen"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/layout_height_constant"
                        android:layout_margin="10dp"
                        android:text="@string/sw_custom_pp_fullscreen"
                        android:layoutDirection="rtl"/>
                </LinearLayout>
                <Button
                    android:id="@+id/b_settings_kastomnaya_pri"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/layout_height_constant"
                    android:text="@string/nastroit_kastom_priborcu"/>
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
