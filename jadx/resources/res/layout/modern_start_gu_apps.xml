<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp">
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/app_to_gu"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <FrameLayout
                    android:background="@drawable/modern_field"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <Spinner
                        android:id="@+id/spinner_auto_start_gu"
                        style="@style/ModernGestureSpinner"/>
                    <ImageView style="@style/ModernGestureDropIcon"/>
                </FrameLayout>
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_auto_start_app_gu"
                android:text="@string/sw_boot_gu"
                style="@style/ModernMapSwitchRow"/>
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/run_black"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/sw_auto_start_black"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/sw_boot_gu_black"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
                <Button
                    android:id="@+id/button_start_black_Settins"
                    android:text="@string/b_settings"
                    android:layout_marginStart="10dp"
                    style="@style/ModernInlineButton"/>
            </LinearLayout>
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@drawable/clipboard"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:gravity="start|center_vertical"
                    android:id="@+id/sw_run_app_more"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/sw_run_app_more"
                    android:layout_weight="1"
                    android:layoutDirection="rtl"
                    android:layout_marginStart="10dp"/>
                <Button
                    android:id="@+id/button_run_app_more_Settins"
                    android:text="@string/b_settings"
                    android:layout_marginStart="10dp"
                    style="@style/ModernInlineButton"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
