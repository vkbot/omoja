<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/BlackBagr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.example.navistart.AnalogClockView
            android:id="@+id/AnalogClockView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginStart="1dp"
            app:borderColor="@color/white"
            app:clockBackgroundColor="@android:color/transparent"
            app:hourColor="@color/white"
            app:minuteColor="@color/white"
            app:numbersColor="@color/white"
            app:secondColor="@color/white"
            app:showNumbers="true"
            app:showSecondPointer="false"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
