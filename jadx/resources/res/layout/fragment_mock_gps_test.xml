<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="vertical"
    android:layout_width="430dp"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/mockGpsCloseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/b_back"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/mock_gps_title"
                android:layout_weight="1"/>
        </LinearLayout>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/mockGpsSourceTabs"
            android:background="?android:attr/colorBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <RadioButton
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/uni_mock_gps_tab_text"
                android:gravity="center"
                android:id="@+id/mockGpsSourcePhoneApp"
                android:background="@drawable/uni_mock_gps_tab_background"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:checked="true"
                android:button="@null"
                android:text="@string/mock_gps_tab_phone"
                android:layout_weight="1"/>
            <RadioButton
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/uni_mock_gps_tab_text"
                android:gravity="center"
                android:id="@+id/mockGpsSourceIosServer"
                android:background="@drawable/uni_mock_gps_tab_background"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:button="@null"
                android:text="@string/mock_gps_tab_ios"
                android:layout_weight="1"/>
            <RadioButton
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/uni_mock_gps_tab_text"
                android:gravity="center"
                android:id="@+id/mockGpsSourceUsb"
                android:background="@drawable/uni_mock_gps_tab_background"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:button="@null"
                android:text="@string/mock_gps_tab_usb"
                android:layout_weight="1"/>
            <RadioButton
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/uni_mock_gps_tab_text"
                android:gravity="center"
                android:id="@+id/mockGpsSourceModem"
                android:background="@drawable/uni_mock_gps_tab_background"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:button="@null"
                android:text="@string/mock_gps_tab_modem"
                android:layout_weight="1"/>
        </RadioGroup>
        <TextView
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/mockGpsSourceDetails"
            android:background="?android:attr/colorBackground"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/mock_gps_phone_details"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/mockGpsIosAppBlock"
            android:background="?android:attr/colorBackground"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <ImageView
                android:id="@+id/mockGpsIosAppQr"
                android:background="?android:attr/colorBackground"
                android:padding="4dp"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/mock_gps_ios_qr_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mock_gps_ios_qr_title"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/mock_gps_ios_qr_subtitle"/>
            </LinearLayout>
        </LinearLayout>
        <CheckBox
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/mockGpsAutoFallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/mock_gps_auto_fallback"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/mockGpsSystemSatellites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mock_gps_system_satellites_waiting"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/mockGpsSystemGnssAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mock_gps_system_gnss_waiting"/>
        <FrameLayout
            android:id="@+id/mockGpsTransportContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>
        <EditText
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:id="@+id/mockGpsHost"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:hint="@string/mock_gps_hint_access_point_ip"
            android:singleLine="true"
            android:inputType="textUri"/>
        <EditText
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:id="@+id/mockGpsPort"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:hint="@string/mock_gps_hint_port"
            android:singleLine="true"
            android:inputType="number"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <Button
                android:id="@+id/mockGpsStartButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="@string/mock_gps_start"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"/>
            <Button
                android:id="@+id/mockGpsStopButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="@string/mock_gps_stop"
                android:layout_weight="1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">
            <View
                android:id="@+id/mockGpsConnectionIndicator"
                android:background="@drawable/mock_gps_status_offline"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/mockGpsConnectionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/mock_gps_connection"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <View
                android:id="@+id/mockGpsSubstitutionIndicator"
                android:background="@drawable/mock_gps_status_offline"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/mockGpsSubstitutionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/mock_gps_substitution"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/mockGpsServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/mock_gps_service"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/mockGpsTargetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mock_gps_address"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/mockGpsPacketStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mock_gps_last_packet"/>
    </LinearLayout>
</ScrollView>
