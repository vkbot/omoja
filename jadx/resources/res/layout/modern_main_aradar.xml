<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/headerText"
            android:gravity="center"
            android:id="@+id/MainLabel"
            android:background="@color/header"
            android:layout_width="match_parent"
            android:layout_height="36sp"
            app:autoSizeTextType="uniform"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp">
            <TextView
                android:text="@string/modern_radar_source"
                style="@style/ModernGroupTitle"/>
            <LinearLayout style="@style/ModernSettingsActionContainer">
                <ImageView
                    android:src="@mipmap/aradar_ico"
                    android:contentDescription="@null"
                    style="@style/ModernSettingsRowIcon"/>
                <FrameLayout
                    android:background="@drawable/modern_field"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <Spinner
                        android:gravity="center_vertical"
                        android:id="@+id/spinner_aradar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:popupBackground="@color/modern_surface_high"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"/>
                    <ImageView
                        android:layout_gravity="end"
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:src="@mipmap/drop"
                        android:contentDescription="@null"
                        android:layout_marginEnd="10dp"/>
                </FrameLayout>
            </LinearLayout>
            <Button
                android:id="@+id/button_open_antiradar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/open_antiradar"/>
            <TextView
                android:layout_marginTop="16dp"
                android:text="@string/modern_radar_display"
                style="@style/ModernGroupTitle"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch2"
                android:text="@string/sw_strelka"
                style="@style/ModernSafetySwitchRow"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch10"
                android:text="@string/sw_str_top_maneuver"
                style="@style/ModernSafetySwitchRow"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch3"
                android:text="@string/sw_strelka_all"
                style="@style/ModernSafetySwitchRow"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
