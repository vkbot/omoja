<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/black"/>
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp"/>
            <corners android:radius="4dp"/>
            <gradient
                android:startColor="@color/heatProgressBackground"
                android:endColor="#ffffff"
                android:angle="270"
                android:centerY="1"
                android:centerColor="@color/heatProgressBackground"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient
                    android:startColor="@color/heatProgressColor"
                    android:endColor="#06101d"
                    android:angle="270"
                    android:centerY="1"
                    android:centerColor="@color/heatProgressColor"/>
                <corners android:radius="4dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
