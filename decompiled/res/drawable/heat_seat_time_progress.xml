<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <stroke android:width="1.0dp" android:color="@color/progressBorderColor" />
            <padding android:left="1.0dp" android:top="1.0dp" android:right="1.0dp" android:bottom="1.0dp" />
            <solid android:color="@color/sliderTrackColorInactive" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="@color/sliderTrackColorActive" />
                <corners android:radius="10.0dp" />
            </shape>
        </clip>
    </item>
</layer-list>
