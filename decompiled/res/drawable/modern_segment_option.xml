<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#80111a24" />
            <corners android:radius="11.0dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_primary_dark" />
            <corners android:radius="11.0dp" />
            <stroke android:width="1.0dp" android:color="@color/modern_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_surface_high" />
            <corners android:radius="11.0dp" />
            <stroke android:width="1.0dp" android:color="@color/modern_divider" />
        </shape>
    </item>
</selector>
