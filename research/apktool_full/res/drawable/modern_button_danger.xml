<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_divider" />
            <corners android:radius="16.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_danger" />
            <corners android:radius="16.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#49262e" />
            <corners android:radius="16.0dp" />
            <stroke android:width="1.0dp" android:color="@color/modern_danger" />
        </shape>
    </item>
</selector>
