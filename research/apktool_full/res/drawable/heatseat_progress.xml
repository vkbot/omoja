<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <stroke android:width="1.0dp" android:color="@color/black" />
            <padding android:left="1.0dp" android:top="1.0dp" android:right="1.0dp" android:bottom="1.0dp" />
            <corners android:radius="4.0dp" />
            <gradient android:startColor="@color/heatProgressBackground" android:endColor="#ffffff" android:angle="270.0" android:centerY="1.0" android:centerColor="@color/heatProgressBackground" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient android:startColor="@color/heatProgressColor" android:endColor="#06101d" android:angle="270.0" android:centerY="1.0" android:centerColor="@color/heatProgressColor" />
                <corners android:radius="4.0dp" />
            </shape>
        </clip>
    </item>
</layer-list>
